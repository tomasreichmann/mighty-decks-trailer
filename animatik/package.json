{
  "name": "animatik",
  "version": "1.0.0",
  "description": "Mighty Decks – Fangs in the Sun, CS / EN animatik",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.541",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts --port=3117",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "assets": "node scripts/prepare.mjs && node pilot/prepare-actor.mjs",
    "predev": "npm run assets",
    "render:cs": "remotion render src/index.ts Fangs-CS out/Fangs-CS.mp4 --concurrency=5",
    "render:en": "remotion render src/index.ts Fangs-EN out/Fangs-EN.mp4 --concurrency=5",
    "render": "npm run assets && npm run render:cs && npm run render:en",
    "verify": "python scripts/verify.py"
  },
  "allowScripts": {
    "esbuild": false
  }
}
